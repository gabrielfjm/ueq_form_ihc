classDiagram
    direction LR

    class Pesquisador {
        +String id
        +String nome
        +String email «unique»
        +String senhaHash «bcrypt»
        +DateTime criadoEm
        +Boolean administrador
        +DateTime? tutorialVistoEm
        +Boolean notificacoesPorEmail
        +String idioma
    }

    class Sessao {
        +String id «SHA-256 of the token»
        +DateTime criadaEm
        +DateTime expiraEm
    }

    class Estudo {
        +String id
        +String titulo
        +String produtoAvaliado
        +String objetivo
        +StatusEstudo status
        +Date dataInicio
        +Date dataFim
        +String slugPublico «unique»
        +Boolean coletarDemografia
        +String idioma
        +String responsavelNome
        +String responsavelEmail
        +String instituicao
        +String riscos
        +String beneficios
        +String? comiteEtica
        +DateTime criadoEm
        +DateTime atualizadoEm
    }

    class Colaboracao {
        +String id
        +PapelColaborador papel
        +StatusConvite status
        +DateTime criadoEm
        +DateTime? respondidoEm
    }

    class Versao {
        +String id
        +String nome
        +Int ordem «unique within the study»
    }

    class Participacao {
        +String id
        +DateTime consentiuEm
        +DateTime criadaEm
        +DateTime? concluidaEm
        +Json? demografia «encrypted»
        +Boolean suspeita
        +Boolean incluidaNaAnalise
        +String? idioma
        +OrigemParticipacao origem
        +Boolean menorDeIdade
    }

    class Resposta {
        +String id
        +Int valor «1 to 7»
    }

    class Item {
        +Int id
        +Int numero «1 to 26, unique»
        +String termoEsquerdo
        +String termoDireito
        +Escala escala
        +Polaridade polaridade
    }

    class Notificacao {
        +String id
        +TipoNotificacao tipo
        +String texto
        +String link
        +Int quantidade
        +DateTime criadaEm
        +DateTime? lidaEm
    }

    class TentativaAcesso {
        +String id
        +String chave «email hash»
        +DateTime criadaEm
    }

    class Traducao {
        +String id
        +String idioma
        +String hashOrigem
        +String texto
        +DateTime criadaEm
    }

    class StatusEstudo {
        <<enumeration>>
        RASCUNHO
        ABERTO
        ENCERRADO
    }
    class Escala {
        <<enumeration>>
        ATRATIVIDADE
        PERSPICUIDADE
        EFICIENCIA
        CONFIABILIDADE
        ESTIMULACAO
        NOVIDADE
    }
    class Polaridade {
        <<enumeration>>
        POSITIVA_DIREITA
        POSITIVA_ESQUERDA
    }
    class OrigemParticipacao {
        <<enumeration>>
        LINK
        IMPORTADA
    }
    class PapelColaborador {
        <<enumeration>>
        EDITOR
        LEITOR
    }
    class StatusConvite {
        <<enumeration>>
        PENDENTE
        ACEITO
        RECUSADO
    }
    class TipoNotificacao {
        <<enumeration>>
        CONVITE
        RESPOSTA
        ALTERACAO
    }

    Pesquisador "1" *-- "0..*" Sessao : opens
    Pesquisador "1" *-- "0..*" Estudo : owns
    Estudo "1" *-- "1..6" Versao : compares
    Versao "1" *-- "0..*" Participacao : receives
    Participacao "1" *-- "0..26" Resposta : contains
    Item "1" <-- "0..*" Resposta : answers
    Estudo "1" *-- "0..*" Colaboracao : is shared in
    Pesquisador "1" *-- "0..*" Colaboracao : takes part as
    Pesquisador "0..1" o-- "0..*" Colaboracao : invited
    Pesquisador "1" *-- "0..*" Notificacao : receives
    Pesquisador "0..1" o-- "0..*" Notificacao : caused
    Estudo "0..1" o-- "0..*" Notificacao : originates

    Estudo ..> StatusEstudo
    Item ..> Escala
    Item ..> Polaridade
    Participacao ..> OrigemParticipacao
    Colaboracao ..> PapelColaborador
    Colaboracao ..> StatusConvite
    Notificacao ..> TipoNotificacao
