erDiagram
    pesquisador ||--o{ sessao : "opens"
    pesquisador ||--o{ estudo : "owns"
    pesquisador ||--o{ colaboracao : "is invited in"
    pesquisador |o--o{ colaboracao : "invited"
    pesquisador ||--o{ notificacao : "receives"
    pesquisador |o--o{ notificacao : "caused"
    estudo ||--o{ colaboracao : "is shared in"
    estudo ||--|{ versao : "has"
    estudo |o--o{ notificacao : "originates"
    versao ||--o{ participacao : "receives"
    participacao ||--o{ resposta : "has"
    item ||--o{ resposta : "is answered in"

    pesquisador {
        text id PK
        text nome
        text email UK
        text senha_hash
        timestamp criado_em
        boolean administrador
        timestamp tutorial_visto_em "nullable"
        boolean notificacoes_por_email
        text idioma
    }
    sessao {
        text id PK "SHA-256 of the token"
        text pesquisador_id FK
        timestamp criada_em
        timestamp expira_em
    }
    estudo {
        text id PK
        text pesquisador_id FK
        text titulo
        text produto_avaliado
        text objetivo
        StatusEstudo status
        date data_inicio
        date data_fim
        text slug_publico UK
        boolean coletar_demografia
        text idioma
        text responsavel_nome
        text responsavel_email
        text instituicao
        text riscos
        text beneficios
        text comite_etica "nullable"
        timestamp criado_em
        timestamp atualizado_em
    }
    colaboracao {
        text id PK
        text estudo_id FK
        text pesquisador_id FK
        text convidado_por_id FK "nullable"
        PapelColaborador papel
        StatusConvite status
        timestamp criado_em
        timestamp respondido_em "nullable"
    }
    versao {
        text id PK
        text estudo_id FK
        text nome
        integer ordem
    }
    item {
        integer id PK
        integer numero UK
        text termo_esquerdo
        text termo_direito
        Escala escala
        Polaridade polaridade
    }
    participacao {
        text id PK
        text versao_id FK
        timestamp consentiu_em
        timestamp criada_em
        timestamp concluida_em "nullable"
        jsonb demografia "nullable, encrypted"
        boolean suspeita
        boolean incluida_na_analise
        text idioma "nullable"
        OrigemParticipacao origem
        boolean menor_de_idade
    }
    resposta {
        text id PK
        text participacao_id FK
        integer item_id FK
        integer valor "CHECK from 1 to 7"
    }
    notificacao {
        text id PK
        text pesquisador_id FK
        text autor_id FK "nullable"
        text estudo_id FK "nullable"
        text colaboracao_id "nullable, no FK"
        TipoNotificacao tipo
        text texto
        text link
        integer quantidade
        timestamp criada_em
        timestamp lida_em "nullable"
    }
    tentativa_acesso {
        text id PK
        text chave "SHA-256 of the email"
        timestamp criada_em
    }
    traducao {
        text id PK
        text idioma
        text hash_origem
        text texto
        timestamp criada_em
    }
