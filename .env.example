# Postgres do docker-compose.yml. Copie para .env antes de rodar pnpm db:migrate
DATABASE_URL="postgresql://ueq:ueq@localhost:5432/ueq?schema=public"

# Pesquisador criado pelo pnpm db:seed, só para desenvolvimento. Sem essas duas linhas o seed não cria
PESQUISADOR_TESTE_EMAIL="pesquisador@exemplo.com"
PESQUISADOR_TESTE_SENHA="senha-de-teste"

# Envio de e-mail (convites e notificações do sino), opcional. Sem estas variáveis os avisos ficam só no
# sino, e quem convida recebe um link de e-mail pronto. Com Gmail: SMTP_HOST="smtp.gmail.com", porta 465 e
# uma senha de app (myaccount.google.com/apppasswords) em SMTP_SENHA, nunca a senha da conta
# SMTP_HOST=""
# SMTP_PORTA="465"
# SMTP_USUARIO=""
# SMTP_SENHA=""
# EMAIL_REMETENTE=""

# Chave da criptografia de campo dos dados demográficos (AES-256-GCM), opcional em desenvolvimento.
# Gere com: openssl rand -base64 32. Guarde uma cópia: sem ela, os dados cifrados não podem ser lidos
# CHAVE_CRIPTOGRAFIA=""
