  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "suspeitas:recalcular": "tsx prisma/recalcular-suspeitas.ts",
    "docs:diagramas": "tsx scripts/gerar-diagramas.ts"
  },
  "pnpm": {
